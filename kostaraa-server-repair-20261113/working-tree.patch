diff --git a/tests/storefront-products.test.cjs b/tests/storefront-products.test.cjs
new file mode 100644
index 0000000..d8c8a3e
--- /dev/null
+++ b/tests/storefront-products.test.cjs
@@ -0,0 +1,32 @@
+const {test}=require('node:test');const assert=require('node:assert/strict');
+const products=require('../helpers/storefront_products');
+const row={id:3,public_id:'public-topaz',product_library_item_id:77,storefront_name:'Topaz',category:'Crystal Collection',description:'Saved website description',selling_price:'550.00',visibility:'active',variant_id:5,on_hand:'8',reserved:'2',display_image:'/storage/storefront-products/topaz.png',option_values:JSON.stringify({weightGrams:10,parcel:{lengthInches:6,widthInches:4,heightInches:1.5,packagingGrams:50}})};
+const channel={id:1,business_profile_id:15};
+function database(rows=[row]) {const calls=[];return {calls,execute:async(sql,values)=>{calls.push({sql,values});return [rows];}};}
+test('public catalog uses saved store price, website image and description',async()=>{
+ const db=database();const items=await products.listProducts(db,channel,true);const item=products.publicProduct(items[0]);
+ assert.equal(item.price,550);assert.equal(item.description,row.description);assert.equal(item.image,row.display_image);assert.equal(item.weightGrams,10);assert.equal(item.available,6);assert.equal(item.purchasable,true);
+ assert.match(db.calls[0].sql,/p\.sales_channel_id=\? AND p\.business_profile_id=\?/);assert.deepEqual(db.calls[0].values,[1,15]);
+});
+test('checkout ignores client price and resolves the current database price by product ID',async()=>{
+ const db=database();const [item]=await products.resolveCart(db,channel,[{id:'public-topaz',name:'Old name',price:1,quantity:2}]);assert.equal(item.price,550);assert.equal(item.name,'Topaz');assert.equal(item.storeProductId,3);assert.equal(item.sourceId,77);assert.match(db.calls[0].sql,/FOR UPDATE/);
+});
+test('older carts resolve by storefront name',async()=>{
+ const [item]=await products.resolveCart(database(),channel,[{name:'Topaz',quantity:1}]);assert.equal(item.price,550);
+});
+test('hidden or unknown products cannot be checked out',async()=>{
+ await assert.rejects(products.resolveCart(database([{...row,visibility:'hidden'}]),channel,[{name:'Topaz',quantity:1}]),/no longer available/);
+ await assert.rejects(products.resolveCart(database(),channel,[{id:'wrong-id',name:'Topaz',quantity:1}]),/no longer available/);
+});
+test('out-of-stock products remain visible but cannot be purchased',async()=>{
+ const [item]=await products.listProducts(database([{...row,visibility:'out_of_stock'}]),channel,true);assert.equal(products.publicProduct(item).purchasable,false);
+ await assert.rejects(products.resolveCart(database([{...row,visibility:'out_of_stock'}]),channel,[{name:'Topaz',quantity:1}]),/no longer available/);
+});
+test('store price validation supports decimals and zero while rejecting missing/invalid prices',()=>{
+ const input={name:'Topaz',price:550,visibility:'active'};assert.equal(products.validateDetails(input).price,550);assert.equal(products.validateDetails({...input,price:0}).price,0);assert.equal(products.validateDetails({...input,price:550.50}).price,550.5);
+ for(const price of [undefined,null,'',-1,NaN,Infinity,0.001])assert.throws(()=>products.validateDetails({...input,price}),/valid product details/);
+});
+test('admin channel lookup is scoped to authenticated ownership',async()=>{
+ const db=database([channel]);await products.ownedChannel(db,43);assert.deepEqual(db.calls[0].values,[43]);assert.match(db.calls[0].sql,/b\.user_id=\?/);
+ await assert.rejects(products.ownedChannel(database([]),44),/Activate/);
+});
