diff --git a/controllers/studio_haze_tracking.js b/controllers/studio_haze_tracking.js
new file mode 100644
index 0000000..dab0229
--- /dev/null
+++ b/controllers/studio_haze_tracking.js
@@ -0,0 +1,49 @@
+const config = require('../config/database');
+const { withTransaction } = require('../helpers');
+
+exports.track = async (req, res) => {
+  res.set('Cache-Control', 'no-store');
+  const orderNumber = String(req.body?.orderNumber || '').trim().toUpperCase();
+  if (!/^SH-(?:[A-F0-9]{12}|[A-F0-9]{8}-[A-F0-9]{4}-4[A-F0-9]{3}-[89AB][A-F0-9]{3}-[A-F0-9]{12})$/.test(orderNumber)) {
+    return res.status(400).json({ message: 'Enter your Studio Haze order number, starting with SH-.' });
+  }
+  try {
+    const order = await withTransaction(config, async connection => {
+      const channelId = process.env.STUDIO_HAZE_SALES_CHANNEL_ID;
+      const [[row]] = await connection.execute(
+        `SELECT o.order_reference, o.order_status, o.payment_status, o.fulfillment_method,
+                o.fulfillment_status, f.tracking_reference, f.estimated_delivery_at
+         FROM sales_channel_orders o
+         JOIN sales_channels sc ON sc.id=o.sales_channel_id AND sc.business_profile_id=o.business_profile_id
+         JOIN business_profiles b ON b.id=sc.business_profile_id
+         JOIN users owner ON owner.id=b.user_id AND owner.id=sc.owner_user_id
+         LEFT JOIN sales_channel_fulfillments f ON f.id=(
+           SELECT MAX(current.id) FROM sales_channel_fulfillments current
+           WHERE current.order_id=o.id AND current.business_profile_id=o.business_profile_id
+         )
+         WHERE o.order_reference=? AND ${channelId ? 'sc.public_id' : 'sc.channel_code'}=?
+           AND LOWER(TRIM(owner.email))=? AND owner.status=1
+           AND sc.deleted_at IS NULL AND b.deleted_at IS NULL LIMIT 1`,
+        [orderNumber, channelId || 'studio-haze', 'hazeldeo1016@gmail.com']
+      );
+      return row;
+    });
+    if (!order) return res.status(404).json({ message: 'No order found. Check your order number and try again.' });
+    const delivery = ['delivery', 'shipping'].includes(order.fulfillment_method);
+    const trackingNumber = delivery && /^[A-Z0-9-]{6,40}$/i.test(order.tracking_reference || '') ? order.tracking_reference : null;
+    // Return only tracking information. Customer contact, address, and payment
+    // proof data are never exposed by an order-number-only lookup.
+    return res.json({ type: 'success', data: {
+      orderNumber: order.order_reference,
+      status: order.order_status,
+      paymentStatus: order.payment_status,
+      fulfillmentStatus: order.fulfillment_status,
+      fulfillmentMethod: delivery ? 'delivery' : 'pickup',
+      trackingNumber,
+      trackingUrl: trackingNumber ? `https://www.jtexpress.ph/trajectoryQuery?flag=1&waybillNo=${encodeURIComponent(trackingNumber)}` : null,
+      estimatedDeliveryAt: delivery ? order.estimated_delivery_at : null,
+    } });
+  } catch {
+    return res.status(503).json({ message: 'Order tracking is temporarily unavailable. Please try again shortly.' });
+  }
+};
diff --git a/helpers/storefront_products.js b/helpers/storefront_products.js
new file mode 100644
index 0000000..6f05514
--- /dev/null
+++ b/helpers/storefront_products.js
@@ -0,0 +1,116 @@
+const crypto = require('node:crypto');
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const problem = (status, message) => Object.assign(new Error(message), { status });
+
+async function ownedChannel(connection, userId) {
+  const [[channel]] = await connection.execute(`SELECT sc.id, sc.business_profile_id, sc.owner_user_id FROM sales_channels sc
+    JOIN business_profiles b ON b.id=sc.business_profile_id
+    WHERE b.user_id=? AND sc.owner_user_id=b.user_id AND b.deleted_at IS NULL AND sc.deleted_at IS NULL
+    AND sc.channel_type='online_store' AND sc.status='active' ORDER BY (sc.channel_code='studio-haze') DESC,sc.id LIMIT 1`,[userId]);
+  if (!channel) throw problem(409,'Activate an online sales channel first.');
+  return channel;
+}
+async function publicChannel(connection) {
+  const publicId=process.env.STUDIO_HAZE_SALES_CHANNEL_ID;
+  const [rows]=await connection.execute(`SELECT sc.id,sc.business_profile_id,sc.owner_user_id FROM sales_channels sc
+    JOIN business_profiles b ON b.id=sc.business_profile_id JOIN users u ON u.id=sc.owner_user_id AND u.id=b.user_id
+    WHERE ${publicId?'sc.public_id':'sc.channel_code'}=? AND LOWER(TRIM(u.email))=? AND u.status=1
+    AND sc.status='active' AND sc.deleted_at IS NULL AND b.deleted_at IS NULL LIMIT 2`,[publicId||'studio-haze','hazeldeo1016@gmail.com']);
+  if(rows.length!==1) throw problem(503,'The storefront is temporarily unavailable.');
+  return rows[0];
+}
+async function listProducts(connection,channel,publicOnly=false,lock=false) {
+  const [rows]=await connection.execute(`SELECT p.id,p.public_id,p.product_library_item_id,p.storefront_name,p.description,p.category,
+    library.target_selling_price AS selling_price,p.visibility,v.id AS variant_id,v.variant_name,v.sku,v.option_values,
+    (SELECT m.media_path FROM sales_channel_product_media m WHERE m.sales_channel_product_id=p.id AND m.business_profile_id=p.business_profile_id AND m.media_type='image' ORDER BY m.is_primary DESC,m.sort_order,m.id LIMIT 1) AS display_image,
+    COALESCE((SELECT SUM(b.on_hand_quantity) FROM sales_channel_inventory_balances b WHERE b.product_variant_id=v.id AND b.business_profile_id=p.business_profile_id),0) AS on_hand,
+    COALESCE((SELECT SUM(b.reserved_quantity) FROM sales_channel_inventory_balances b WHERE b.product_variant_id=v.id AND b.business_profile_id=p.business_profile_id),0) AS reserved,
+    COALESCE((SELECT MAX(b.low_stock_level) FROM sales_channel_inventory_balances b WHERE b.product_variant_id=v.id AND b.business_profile_id=p.business_profile_id),5) AS low_stock
+    FROM sales_channel_products p JOIN product_library_items library ON library.id=p.product_library_item_id AND library.deleted_at IS NULL AND library.status<>'archived' LEFT JOIN sales_channel_product_variants v ON v.id=(SELECT MIN(v1.id) FROM sales_channel_product_variants v1 WHERE v1.sales_channel_product_id=p.id AND v1.deleted_at IS NULL)
+    WHERE p.sales_channel_id=? AND p.business_profile_id=? AND p.deleted_at IS NULL ${publicOnly?"AND p.visibility IN ('active','out_of_stock')":''}
+    ORDER BY p.id ${lock?'FOR UPDATE':''}`,[channel.id,channel.business_profile_id]);
+  return rows.map(row=>{
+    let details=row.option_values||{};if(typeof details==='string') {try{details=JSON.parse(details);}catch{details={};}}
+    return {...row,details};
+  });
+}
+function publicProduct(row) {
+  return {id:row.public_id,name:row.storefront_name,collection:row.category||'Other',price:row.selling_price===null?null:Number(row.selling_price),
+    description:row.description||'',image:row.display_image||null,position:row.details.imagePosition||'center',
+    weightGrams:row.details.weightGrams||null,parcel:row.details.parcel||null,available:Math.max(0,Number(row.on_hand)-Number(row.reserved)),
+    purchasable:row.visibility==='active' && row.selling_price!==null && Number.isFinite(Number(row.selling_price))};
+}
+async function resolveCart(connection,channel,items) {
+  const products=await listProducts(connection,channel,true,true);
+  return items.map(item=>{
+    const product=products.find(p=>item.id?p.public_id===item.id:p.storefront_name===item.name);
+    if(!product||product.visibility!=='active') throw problem(422,`${item.name} is no longer available. Refresh your cart.`);
+    const price=product.selling_price===null?NaN:Number(product.selling_price);
+    if(!Number.isFinite(price)||price<0)throw problem(422,'A product price is unavailable.');
+    return {...item,name:product.storefront_name,price,storeProductId:product.id,variantId:product.variant_id,sourceId:product.product_library_item_id,
+      weightGrams:product.details.weightGrams,parcel:product.details.parcel};
+  });
+}
+function validateDetails(body) {
+  const name=String(body.name||'').trim();const description=String(body.description||'').trim();
+  const category=String(body.category||'Other').trim();const price=Number(body.price);
+  const visibility=String(body.visibility||'draft');
+  if(!name||name.length>180||description.length>2000||category.length>120||body.price===undefined||body.price===null||body.price===''||!Number.isFinite(price)||price<0||price>999999999999.99||Math.abs(price*100-Math.round(price*100))>0.001||!['active','draft','hidden','out_of_stock'].includes(visibility))throw problem(422,'Enter valid product details, a store price, and visibility.');
+  return {name,description,category,price,visibility};
+}
+async function saveImage(value) {
+  if(!value)return null;
+  if(/^\/storage\/storefront-products\/[a-zA-Z0-9-]+\.(png|jpg|webp)$/.test(value))return value;
+  if(/^https:\/\//.test(value)&&value.length<=500) return value;
+  const match=/^data:image\/(png|jpeg|webp);base64,([A-Za-z0-9+/=]+)$/.exec(value);
+  if(!match)throw problem(422,'Choose a PNG, JPG or WebP display image.');
+  const buffer=Buffer.from(match[2],'base64');if(!buffer.length||buffer.length>5*1024*1024)throw problem(422,'Display images must be no larger than 5 MB.');
+  const signature=match[1]==='png'?buffer.subarray(0,8).equals(Buffer.from([137,80,78,71,13,10,26,10])):match[1]==='jpeg'?buffer[0]===255&&buffer[1]===216:buffer.toString('ascii',0,4)==='RIFF'&&buffer.toString('ascii',8,12)==='WEBP';
+  if(!signature)throw problem(422,'The image file is invalid.');
+  const filename=`${crypto.randomUUID()}.${match[1]==='jpeg'?'jpg':match[1]}`;
+  const dir=path.resolve(__dirname,'../storage/storefront-products');await fs.mkdir(dir,{recursive:true});await fs.writeFile(path.join(dir,filename),buffer,{flag:'wx'});
+  return `/storage/storefront-products/${filename}`;
+}
+async function saveProduct(connection,channel,libraryId,userId,body) {
+  const [[source]]=await connection.execute('SELECT id,target_selling_price FROM product_library_items WHERE id=? AND user_id=? AND deleted_at IS NULL AND status<>?',[libraryId,userId,'archived']);
+  if(!source)throw problem(404,'Product Library item not found.');
+  if(source.target_selling_price===null||source.target_selling_price===undefined)throw problem(422,'Set the Target Price in KostAraa before publishing this product.');
+  const details=validateDetails({...body,price:source.target_selling_price});
+  const [[existing]]=await connection.execute('SELECT id,public_id FROM sales_channel_products WHERE sales_channel_id=? AND product_library_item_id=? AND deleted_at IS NULL FOR UPDATE',[channel.id,libraryId]);
+  const image=await saveImage(body.displayImage);
+  let id=existing?.id;
+  if(id) await connection.execute('UPDATE sales_channel_products SET storefront_name=?,description=?,category=?,selling_price=?,visibility=?,updated_by_user_id=?,published_at=COALESCE(published_at,NOW()) WHERE id=? AND business_profile_id=?',[details.name,details.description,details.category,details.price,details.visibility,userId,id,channel.business_profile_id]);
+  else {
+    const slug=details.name.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')+'-'+libraryId;
+    const [created]=await connection.execute(`INSERT INTO sales_channel_products (business_profile_id,sales_channel_id,product_library_item_id,public_id,slug,storefront_name,description,category,selling_price,visibility,published_at,created_by_user_id,updated_by_user_id) VALUES (?,?,?,?,?,?,?,?,?,?,NOW(),?,?)`,[channel.business_profile_id,channel.id,libraryId,crypto.randomUUID(),slug,details.name,details.description,details.category,details.price,details.visibility,userId,userId]);id=created.insertId;
+  }
+  const [[variant]]=await connection.execute('SELECT id FROM sales_channel_product_variants WHERE sales_channel_product_id=? AND deleted_at IS NULL ORDER BY id LIMIT 1 FOR UPDATE',[id]);
+  const variantName=String(body.variant||'Standard').trim().slice(0,180)||'Standard';const sku=String(body.sku||`SH-${libraryId}`).trim().slice(0,100)||`SH-${libraryId}`;
+  if(variant) await connection.execute('UPDATE sales_channel_product_variants SET selling_price=?,sku=?,variant_name=? WHERE id=?',[details.price,sku,variantName,variant.id]);
+  else await connection.execute(`INSERT INTO sales_channel_product_variants (business_profile_id,sales_channel_product_id,product_library_item_id,variant_name,sku,selling_price,status) VALUES (?,?,?,?,?,?,'active')`,[channel.business_profile_id,id,libraryId,variantName,sku,details.price]);
+  await connection.execute("DELETE FROM sales_channel_product_media WHERE sales_channel_product_id=? AND business_profile_id=? AND media_type='image'",[id,channel.business_profile_id]);
+  if(image)await connection.execute("INSERT INTO sales_channel_product_media (business_profile_id,sales_channel_product_id,media_path,alt_text,is_primary) VALUES (?,?,?,?,1)",[channel.business_profile_id,id,image,details.name]);
+  if(!existing && body.stock!==undefined) {
+    const stock=Number(body.stock);
+    if(!Number.isInteger(stock)||stock<0||stock>1000000)throw problem(422,'Enter a valid initial stock quantity.');
+    if(stock>0) await adjustStock(connection,channel,libraryId,userId,{quantity:stock,direction:'add'});
+  }
+  return id;
+}
+module.exports={ownedChannel,publicChannel,listProducts,publicProduct,resolveCart,saveProduct,validateDetails};
+
+async function adjustStock(connection,channel,libraryId,userId,body) {
+  const quantity=Number(body.quantity);const direction=body.direction;
+  if(!Number.isInteger(quantity)||quantity<1||quantity>1000000||!['add','remove'].includes(direction))throw problem(422,'Enter a valid stock adjustment.');
+  const [[variant]]=await connection.execute(`SELECT v.id FROM sales_channel_product_variants v JOIN sales_channel_products p ON p.id=v.sales_channel_product_id WHERE p.sales_channel_id=? AND p.business_profile_id=? AND p.product_library_item_id=? AND p.deleted_at IS NULL AND v.deleted_at IS NULL ORDER BY v.id LIMIT 1 FOR UPDATE`,[channel.id,channel.business_profile_id,libraryId]);
+  if(!variant)throw problem(404,'Publish this product before adjusting store stock.');
+  await connection.execute(`INSERT INTO sales_channel_inventory_locations (business_profile_id,sales_channel_id,location_name,is_default) VALUES (?,?,'Store',1) ON DUPLICATE KEY UPDATE id=LAST_INSERT_ID(id)`,[channel.business_profile_id,channel.id]);
+  const [[location]]=await connection.execute("SELECT id FROM sales_channel_inventory_locations WHERE sales_channel_id=? AND location_name='Store' AND business_profile_id=?",[channel.id,channel.business_profile_id]);
+  await connection.execute(`INSERT INTO sales_channel_inventory_balances (business_profile_id,inventory_location_id,product_variant_id) VALUES (?,?,?) ON DUPLICATE KEY UPDATE id=id`,[channel.business_profile_id,location.id,variant.id]);
+  const [[balance]]=await connection.execute('SELECT id,on_hand_quantity,reserved_quantity FROM sales_channel_inventory_balances WHERE inventory_location_id=? AND product_variant_id=? FOR UPDATE',[location.id,variant.id]);
+  const next=Number(balance.on_hand_quantity)+(direction==='add'?quantity:-quantity);
+  if(next<Number(balance.reserved_quantity))throw problem(422,'This adjustment would remove reserved or unavailable stock.');
+  await connection.execute('UPDATE sales_channel_inventory_balances SET on_hand_quantity=? WHERE id=?',[next,balance.id]);
+}
+module.exports.adjustStock=adjustStock;
