diff --git a/tests/studio-haze-shipping.test.cjs b/tests/studio-haze-shipping.test.cjs
new file mode 100644
index 0000000..b3eb600
--- /dev/null
+++ b/tests/studio-haze-shipping.test.cjs
@@ -0,0 +1,30 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { quoteShipping } = require('../controllers/studio_haze_shipping');
+const products = ['Shelly', 'Smokey', 'Topaz', 'Raspberry Blue', 'Bubblegum Pink'];
+for (const name of products) test(`${name} has a configured parcel and shipping weight`, () => {
+  const result = quoteShipping([{name, quantity: 1}], 'Metro Manila');
+  assert.equal(result.fee, 85);
+  assert.equal(result.actualGrams, name === 'Shelly' ? 63 : 60);
+  assert.equal(result.chargeableGrams, 99);
+});
+test('mixed Smokey/Raspberry cart uses one standard parcel', () => {
+  const quote = quoteShipping([{name:'Smokey',quantity:1},{name:'Raspberry Blue',quantity:1}], 'Metro Manila');
+  assert.equal(quote.fee,85);
+  assert.equal(quote.actualGrams,70);
+});
+test('configured zones and weight brackets retain their rates', () => {
+  for (const [province,fee] of [['Metro Manila',85],['Cebu',100],['Davao del Sur',105],['Cavite',95],['Special Geographic Area',105]]) {
+    assert.equal(quoteShipping([{name:'Topaz',quantity:1}],province).fee,fee);
+  }
+  assert.equal(quoteShipping([{name:'Topaz',quantity:50}],'Cebu').fee,180);
+  assert.equal(quoteShipping([{name:'Topaz',quantity:99}],'Cebu').fee,200);
+});
+test('pickup and delivery promotions retain free shipping', () => {
+  assert.equal(quoteShipping([{name:'Smokey',quantity:1}],'',{type:'pickup'}).fee,0);
+  assert.equal(quoteShipping([{name:'Raspberry Blue',quantity:1}],'Cebu',{type:'delivery'}).fee,0);
+});
+test('unknown provinces and unconfigured products still fail', () => {
+  assert.throws(() => quoteShipping([{name:'Topaz',quantity:1}],'Nowhere'),/Philippine province/);
+  assert.throws(() => quoteShipping([{name:'Unknown',quantity:1}],'Cebu'),/pending/);
+});
diff --git a/tests/studio-haze-tracking.test.cjs b/tests/studio-haze-tracking.test.cjs
new file mode 100644
index 0000000..82918fd
--- /dev/null
+++ b/tests/studio-haze-tracking.test.cjs
@@ -0,0 +1,52 @@
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const delivery = { order_reference:'SH-38B9A1FF6F2B',order_status:'processing',payment_status:'paid',fulfillment_method:'shipping',fulfillment_status:'in_transit',tracking_reference:'780695272093',estimated_delivery_at:'2026-11-20T15:59:59.000Z', customer_email_snapshot:'private@example.test',delivery_address_snapshot:'Private address' };
+function load({row=delivery, fail=false, channelId}={}) {
+  const exports = {}, queries = [];
+  vm.runInNewContext(fs.readFileSync(path.join(__dirname,'../controllers/studio_haze_tracking.js'),'utf8'),{
+    exports,process:{env:channelId ? {STUDIO_HAZE_SALES_CHANNEL_ID:channelId} : {}},
+    require(name) {
+      if(name==='../config/database')return {};
+      if(name==='../helpers')return {withTransaction:async (_,fn)=>{
+        if(fail)throw new Error('Database unavailable');
+        return fn({execute:async (sql,params)=>{queries.push({sql,params});return [[...(row ? [row]:[])]];}});
+      }};
+      throw new Error(name);
+    },
+  });
+  async function track(orderNumber='SH-38B9A1FF6F2B') {
+    const response={code:200,headers:{},set(k,v){this.headers[k]=v;return this;},status(v){this.code=v;return this;},json(body){this.body=body;return this;}};
+    await exports.track({body:{orderNumber}},response);return response;
+  }
+  return {track,queries};
+}
+test('delivery lookup returns saved status and an official J&T waybill link',async()=>{
+  const api=load();const res=await api.track(' sh-38b9a1ff6f2b ');
+  assert.equal(res.code,200);assert.equal(res.headers['Cache-Control'],'no-store');
+  assert.equal(res.body.data.fulfillmentMethod,'delivery');
+  assert.equal(res.body.data.status,'processing');
+  const url=new URL(res.body.data.trackingUrl);assert.equal(url.hostname,'www.jtexpress.ph');assert.equal(url.searchParams.get('waybillNo'),delivery.tracking_reference);
+  assert.equal(JSON.stringify(res.body).includes('private@example.test'),false);
+  assert.equal(JSON.stringify(res.body).includes('Private address'),false);
+  assert.match(api.queries[0].sql,/sc\.business_profile_id=o\.business_profile_id/);
+  assert.equal(api.queries[0].params[0],'SH-38B9A1FF6F2B');assert.equal(api.queries[0].params[2],'hazeldeo1016@gmail.com');
+});
+test('pickup order has no courier tracking even if old tracking data exists',async()=>{
+  const res=await load({row:{...delivery,fulfillment_method:'pickup'}}).track();
+  assert.equal(res.body.data.fulfillmentMethod,'pickup');assert.equal(res.body.data.trackingUrl,null);assert.equal(res.body.data.trackingNumber,null);assert.equal(res.body.data.estimatedDeliveryAt,null);
+});
+test('delivery awaiting waybill has no invented tracking link',async()=>{
+  const res=await load({row:{...delivery,tracking_reference:null}}).track();assert.equal(res.body.data.trackingUrl,null);
+});
+test('invalid order number fails before querying the database',async()=>{
+  const api=load();assert.equal((await api.track("SH-' OR 1=1")).code,400);assert.equal(api.queries.length,0);
+});
+test('unknown orders return not found and outages return unavailable',async()=>{
+  assert.equal((await load({row:null}).track()).code,404);assert.equal((await load({fail:true}).track()).code,503);
+});
+test('channel public ID is respected',async()=>{
+  const api=load({channelId:'configured-id'});await api.track();assert.match(api.queries[0].sql,/sc\.public_id=\?/);assert.equal(api.queries[0].params[1],'configured-id');
+});
