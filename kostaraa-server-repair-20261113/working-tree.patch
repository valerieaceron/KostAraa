+++ b/scripts/studio-haze-preview.cjs
@@ -0,0 +1,25 @@
+// Local preview of the public storefront endpoints, without background jobs.
+// Uses the API project's existing server-side .env; never exposes credentials.
+require('dotenv').config();
+const express = require('express');
+const cors = require('cors');
+const checkout = require('../controllers/studio_haze_checkout');
+const tracking = require('../controllers/studio_haze_tracking');
+const app = express();
+app.use(cors({ origin: ['http://127.0.0.1:43827', 'http://localhost:43827', 'http://localhost:3005', 'http://127.0.0.1:3005'] }));
+app.use(express.json({ limit: '8mb' }));
+app.use('/storage/storefront-products',express.static(require('node:path').resolve(__dirname,'../storage/storefront-products')));
+const {checkGeneralAuth}=require('../middlewares/auth');
+const products=require('../controllers/storefront_products');
+app.get('/api/sales-channel/products',checkGeneralAuth,products.list);
+app.put('/api/sales-channel/products/:libraryId',checkGeneralAuth,products.save);
+app.post('/api/sales-channel/products/:libraryId/stock',checkGeneralAuth,products.adjust);
+const base = '/api/storefront/studio-haze';
+app.get(`${base}/products`, require('../controllers/storefront_products').catalog);
+app.get(`${base}/checkout`, checkout.status);
+app.post(`${base}/checkout/shipping-quote`, checkout.shippingQuote);
+app.post(`${base}/checkout/promotion`, checkout.promotion);
+app.post(`${base}/checkout/scan-receipt`, checkout.scanReceipt);
+app.post(`${base}/checkout`, checkout.checkout);
+app.post(`${base}/orders/track`, tracking.track);
+app.listen(43828, '127.0.0.1', () => console.log('Studio Haze preview API: http://127.0.0.1:43828'));
diff --git a/scripts/sync-studio-haze-products.cjs b/scripts/sync-studio-haze-products.cjs
new file mode 100644
index 0000000..eeb005c
--- /dev/null
+++ b/scripts/sync-studio-haze-products.cjs
@@ -0,0 +1,27 @@
+// Copies website details into the owner's existing costed products. No stock or
+// costing amounts are changed. Dry run by default; pass --apply to persist.
+require('dotenv').config();
+const fs=require('node:fs/promises');const path=require('node:path');const mysql=require('mysql2/promise');
+const {saveProduct}=require('../helpers/storefront_products');
+const root=process.env.STUDIO_HAZE_SITE_ROOT||'/Users/Shared/Business/Elvio/Studio Haze/ver2';
+const collections={Sea:'Pearls and a shell-like texture. Each strand can be tied, looped, and styled in your own way.',Crystal:'Earth tones and baroque pearls. Glistening, crystal-like beads to spice up any outfit.',Candy:'Glossy colors, finished with freshwater pearls. Play and style these fun colors!'};
+const source=[['Shelly','Sea',650,13,'shelly-stand.webp'],['Smokey','Crystal',550,10,'smokey.webp'],['Topaz','Crystal',550,10,'topaz.png'],['Raspberry Blue','Candy',350,10,'raspberry-blue.webp'],['Bubblegum Pink','Candy',350,10,'bubblegum.webp']];
+(async()=>{
+ const c=await mysql.createConnection(require('../config/database'));
+ try {
+  await c.beginTransaction();
+  const [channels]=await c.execute(`SELECT sc.id,sc.business_profile_id,sc.owner_user_id FROM sales_channels sc JOIN business_profiles b ON b.id=sc.business_profile_id JOIN users u ON u.id=sc.owner_user_id AND u.id=b.user_id WHERE LOWER(TRIM(u.email))=? AND sc.channel_code='studio-haze' AND sc.deleted_at IS NULL AND b.deleted_at IS NULL AND sc.status='active' FOR UPDATE`,['hazeldeo1016@gmail.com']);
+  if(channels.length!==1)throw new Error('Expected exactly one Studio Haze channel.');const channel=channels[0];
+  for(const [name,collection,price,grams,image] of source){
+   const [rows]=await c.execute('SELECT id FROM product_library_items WHERE user_id=? AND item_name=? AND deleted_at IS NULL AND status<>? ORDER BY updated_at DESC,id DESC',[channel.owner_user_id,`${name} (${collection} Collection)`,'archived']);
+   if(!rows.length)throw new Error(`No matching costed product for ${name}.`);
+   console.log(`${name}: library ${rows[0].id}, price PHP ${price}, ${rows.length>1?'latest matching record; older duplicate untouched':'matched'}`);
+   if(!process.argv.includes('--apply'))continue;
+   const buffer=await fs.readFile(path.join(root,'public/images',image));
+   const mime=image.endsWith('.png')?'png':'webp';
+   const id=await saveProduct(c,channel,rows[0].id,channel.owner_user_id,{name,description:collections[collection]+' Handmade with seed beads and freshwater pearls, secured with UV resin.',category:`${collection} Collection`,price,visibility:'active',displayImage:`data:image/${mime};base64,${buffer.toString('base64')}`});
+   await c.execute(`UPDATE sales_channel_product_variants SET option_values=JSON_SET(COALESCE(option_values,JSON_OBJECT()),'$.weightGrams',?,'$.parcel',JSON_OBJECT('lengthInches',6,'widthInches',4,'heightInches',1.5,'packagingGrams',50),'$.imagePosition',?) WHERE sales_channel_product_id=? AND business_profile_id=? AND deleted_at IS NULL`,[grams,name==='Bubblegum Pink'?'45% center':'center',id,channel.business_profile_id]);
+  }
+  if(process.argv.includes('--apply')){await c.commit();console.log('Copied five product listings. Existing stock and cost data preserved.');}else{await c.rollback();console.log('Dry run only. Use --apply to copy listings.');}
+ }catch(e){await c.rollback();throw e;}finally{await c.end();}
+})().catch(e=>{console.error(e.message);process.exitCode=1;});
